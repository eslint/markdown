{
  "root": true,
  "env": {
    "browser": true
  },
  "plugins": ["markdown"],
  "overrides": [
    {
      "files": ["*.md", "*.mkdn", "*.mdown", "*.markdown", "*.custom"],
      "processor": "markdown/markdown"
    }
  ],
  "rules": {
    "dot-notation": "error",
    "no-console": "error",
    "no-undef": "error",
    "no-warning-comments": ["error", { "terms": ["eslint-disable"] }],
    "yoda": "error"
  }
}
